@using CaloriesTracker.Services
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="relative flex flex-col md:flex-row">
    <aside class="bg-gradient-to-b from-[rgb(5,39,103)] to-[#3a0647] md:w-64 md:h-screen md:sticky md:top-0">
        <NavMenu />
    </aside>

    <main class="flex-1">
        <div class="flex items-center justify-between md:justify-end h-14 bg-[#f7f7f7] border-b border-[#d6d5d5] md:sticky md:top-0 md:z-10 px-3 md:px-6">
            @if (user != null)
            {
                <span class="text-sm leading-none">@user.Email</span>
                <button class="px-3 py-2 hover:bg-gray-300 rounded-lg transition-colors flex-shrink-0 md:ml-2" title="Logout" @onclick="Logout">
                    <i class="fas fa-right-from-bracket"></i>
                </button>
            }
            else
            {
                <span class="text-sm leading-none">Guest</span>
                <button class="px-3 py-2 hover:bg-gray-300 rounded-lg transition-colors flex-shrink-0 md:ml-2" title="Login" @onclick="Login">
                    <i class="fas fa-right-to-bracket"></i>
                </button>
            }
        </div>

        <article class="p-4">
            @Body
        </article>
    </main>
</div>

@code {
    private Supabase.Gotrue.User? user;

    protected override async Task OnInitializedAsync()
    {
        user = await AuthService.GetCurrentUserAsync();
        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private async Task HandleAuthStateChanged()
    {
        user = await AuthService.GetCurrentUserAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        user = null;
        NavigationManager.NavigateTo(NavigationManager.BaseUri, forceLoad: true);
    }

    private void Login()
    {
        NavigationManager.NavigateTo("/settings");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}

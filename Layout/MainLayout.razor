@using CaloriesTracker.Services
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject FirebaseAuthService AuthService
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (AuthService.IsLoggedIn)
            {
                <span class="user-font">@AuthService.Email</span>
                <button class="btn btn btn-outline-secondary icon-button ms-3" title="Logout" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            }
            else
            {
                <span class="user-font">Guest</span>
                <a href="settings" class="btn btn-outline-secondary icon-button" title="Login">
                    <i class="bi bi-box-arrow-in-right"></i>
                </a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .user-font {
        font-size: 0.9rem;
    }
    .icon-button {
        padding: 1px 6px;
        border: none;
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += StateHasChanged;
        await AuthService.InitializeAsync();
    }

    public void Dispose() => AuthService.AuthStateChanged -= StateHasChanged;

    private async Task Logout()
    {
        await AuthService.SignOutAsync();
        Nav.NavigateTo("/settings", forceLoad: true);
    }
}
